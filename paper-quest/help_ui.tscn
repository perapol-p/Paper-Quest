[node name="StepsLabel" type="Label" parent="Overlay/Panel/Margin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.88, 0.85, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 2
text = "1. รอลูกค้ามายืนที่โต๊ะฝั่งซ้าย
2. ลาก \"บัตรประจำตัว\" จากฝั่งซ้าย ไปวางบนโต๊ะฝั่งขวา เพื่อดูข้อมูลบัตร
3. ลาก \"ใบเควส\" จากฝั่งซ้าย ไปวางบนโต๊ะฝั่งขวา เพื่อดูรายละเอียดเควส"

[node name="CheckLabel" type="Label" parent="Overlay/Panel/Margin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.55, 1)
theme_override_font_sizes/font_size = 15
text = "ต้องเช็คก่อนตัดสินใจ 3 อย่าง"

[node name="CheckListLabel" type="Label" parent="Overlay/Panel/Margin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.88, 0.85, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 2
text = "• Rank บนบัตร ต้อง \"เท่ากับหรือสูงกว่า\" Rank ที่เควสต้องการ
   (เรียงจากต่ำไปสูง: F < E < D < C < B < A < S)
• วันหมดอายุบนบัตร ต้องยังไม่เลยวันที่ปัจจุบัน (ดูวันที่ปัจจุบันมุมล่างซ้ายของจอ)
• ตรากิลด์บนใบเควส ต้องเป็นของจริง สังเกตรายละเอียดให้ดี ของปลอมจะเพี้ยนเล็กน้อย"

